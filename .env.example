# Copy to apps/api/.env and apps/web/.env.local as documented in README.md

# --- API (apps/api/.env) ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tiffin_platform
# MongoDB Atlas example (replace user/password/cluster):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tiffin_platform?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change-me-use-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-another-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP (dev: logged to console; prod: integrate SMS provider)
OTP_EXPIRES_MINUTES=10
DEV_OTP_STATIC=123456

# Payment: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CORS_ORIGIN=http://localhost:3000
TZ=Asia/Kolkata

# Bootstrap admin (used by npm run seed once)
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_PHONE=9999999999

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Jabalpur Tiffin Service
